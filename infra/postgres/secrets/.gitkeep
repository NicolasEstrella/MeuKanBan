# Diretorio de secrets locais do Compose (conteudo NAO versionado - ver .gitignore).
# Crie aqui o arquivo 'postgres_password' contendo apenas a senha local, em uma linha:
#
#   Set-Content infra/postgres/secrets/postgres_password 'sua-senha-local' -NoNewline
#
# ATENCAO: se o volume meukanban_postgres-data ja foi inicializado, a senha
# deste arquivo DEVE ser a mesma usada na primeira inicializacao do volume.
