# Copie para .env (gitignored) e preencha:  cp .env.example .env
#
# SENHA FORA DO .env: a senha do PostgreSQL e lida de um ARQUIVO (Docker secret),
# para que `docker compose config` e `docker inspect` nunca exponham o valor.
# Crie o arquivo local (gitignored) contendo apenas a senha, em uma linha:
#   Set-Content infra/postgres/secrets/postgres_password 'sua-senha-local' -NoNewline
# Ou aponte para outro caminho descomentando a linha abaixo:
# POSTGRES_PASSWORD_FILE=./caminho/para/seu/arquivo
#
# ATENCAO (volume existente): o Postgres so aplica as credenciais na PRIMEIRA
# inicializacao de um volume vazio. Se o volume meukanban_postgres-data ja foi
# inicializado, .env e arquivo de senha DEVEM reproduzir as MESMAS credenciais
# desse volume, ou a API nao autentica. Para trocar credenciais:
# docker compose down -v  (APAGA todos os dados - acao explicita e documentada)

POSTGRES_DB=meukanban_db
POSTGRES_USER=estrelni

# URL publica (browser) da API consumida pelo frontend
API_URL=http://localhost:8080
